{
  "actorSpecification": 1,
  "name": "olx-india-classifieds-scraper",
  "title": "OLX India Classifieds Scraper",
  "description": "Scrape OLX India classifieds listings with prices, seller type, categories, locations, images, posting dates, and listing URLs. No login or API key required.",
  "version": "1.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "ts-start"
  },
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 512,
  "maxMemoryMbytes": 1024,
  "categories": ["ECOMMERCE", "OTHER"],
  "categoriesVersion": "1.0.0",
  "exampleRunInput": {
    "body": "{\"keywords\":[\"iphone\"],\"locations\":[\"Mumbai\"],\"maxResults\":1,\"includeItemDetails\":false,\"includeDescription\":false,\"proxyConfiguration\":{\"useApifyProxy\":true}}",
    "contentType": "application/json"
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts. Number of events depends on memory (one per GB, minimum one).",
          "eventPriceUsd": 0.00005,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        },
        "listing-scraped": {
          "eventTitle": "Listing scraped",
          "eventDescription": "Charged once for each clean OLX India classified listing saved to the dataset.",
          "eventPriceUsd": 0.002,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  }
}
